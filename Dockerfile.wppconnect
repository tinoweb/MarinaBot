FROM node:22-bullseye-slim

ENV DEBIAN_FRONTEND=noninteractive
ENV PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true
ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/google-chrome-stable

# Instala dependencias do sistema + Google Chrome
RUN apt-get update && apt-get install -y --no-install-recommends \
    wget \
    gnupg \
    ca-certificates \
    git \
    libgconf-2-4 \
    libxshmfence-dev \
    libgbm-dev \
    libasound2 \
    libatk1.0-0 \
    libatk-bridge2.0-0 \
    libcups2 \
    libdrm2 \
    libgtk-3-0 \
    libnspr4 \
    libnss3 \
    libx11-xcb1 \
    libxcomposite1 \
    libxdamage1 \
    libxfixes3 \
    libxkbcommon0 \
    libxrandr2 \
    libxss1 \
    fonts-liberation \
    xdg-utils \
    && wget -q -O - https://dl-ssl.google.com/linux/linux_signing_key.pub \
       | gpg --dearmor -o /usr/share/keyrings/googlechrome-linux-keyring.gpg \
    && echo "deb [arch=amd64 signed-by=/usr/share/keyrings/googlechrome-linux-keyring.gpg] \
       http://dl.google.com/linux/chrome/deb/ stable main" \
       > /etc/apt/sources.list.d/google-chrome.list \
    && apt-get update \
    && apt-get install -y google-chrome-stable \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /home/user/wppconnect-server

# Clona o repositório
RUN git clone https://github.com/wppconnect-team/wppconnect-server.git .

# Técnica Segura: Modifica o código fonte para suportar variáveis de ambiente nativamente
RUN sed -i "s/secretKey: 'THISISMYSECURETOKEN'/secretKey: process.env.SECRET_KEY || 'marina_bot_secret'/g" src/config.ts && \
    sed -i "s/deviceName: 'WppConnect'/deviceName: process.env.DEVICE_NAME || 'MarinaBot'/g" src/config.ts && \
    sed -i "s/port: '21465'/port: process.env.PORT || '21465'/g" src/config.ts && \
    sed -i "s/url: null/url: process.env.APP_URL ? process.env.APP_URL + '\/webhook\/wppconnect' : null/g" src/config.ts

# Instala dependencias e compila
RUN npm install && npm run build

# Diretorio de sessoes/tokens persistente
RUN mkdir -p tokens

EXPOSE 21465

# Script de startup: Aplica hotfixes de runtime e inicia o servidor
RUN printf '#!/bin/sh\n\
\n\
# Desativa o interceptor res.send que causa loop e erro de headers\n\
# Este interceptor adicionava "session" no JSON, mas o custo de instabilidade é alto.\n\
sed -i "s/res.send = async function (data)/return next(); res.send = async function (data)/g" /home/user/wppconnect-server/dist/index.js\n\
\n\
# Hotfix para garantir que returnError não envie resposta se os headers já foram enviados\n\
sed -i "s/function returnError(req, res, error) {/function returnError(req, res, error) { if (res.headersSent) return;/g" /home/user/wppconnect-server/dist/controller/messageController.js\n\
\n\
# Hotfix para garantir que resultados vazios não causem envio duplo\n\
sed -i "s/if (results.length === 0) res.status(400)/if (results.length === 0) return res.status(400)/g" /home/user/wppconnect-server/dist/controller/messageController.js\n\
\n\
# Aumenta o timeout de autoClose para 5 minutos (300s)\n\
# Como o config.ts não tem esse campo, procuramos no arquivo compilado de utilitários\n\
grep -l "autoClose: 60000" /home/user/wppconnect-server/dist/**/*.js | xargs sed -i "s/autoClose: 60000/autoClose: 300000/g" 2>/dev/null || true\n\
\n\
echo "Iniciando WPP Connect Server com correções de estabilidade..."\n\
exec node /home/user/wppconnect-server/dist/server.js\n' > /start.sh && chmod +x /start.sh

CMD ["/start.sh"]
